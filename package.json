{
  "name": "harkback",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "vitest run",
    "typecheck": "tsc -p packages/spec && tsc -p packages/core && pnpm --filter @harkback/extension typecheck",
    "e2e": "pnpm --filter @harkback/extension e2e",
    "zip": "pnpm --filter @harkback/extension zip",
    "zip:edge": "pnpm --filter @harkback/extension exec wxt zip -b edge",
    "release": "tools/package.sh",
    "check:build": "pnpm --filter @harkback/extension build && HB_CHECK_BUILD=1 vitest run apps/extension/test/manifest.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "tools/lint/node_modules/.bin/eslint -c tools/lint/eslint.config.js ."
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.5",
    "prettier": "^3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
