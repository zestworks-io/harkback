{
  "name": "@harkback/extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "postinstall": "wxt prepare",
    "build": "wxt build",
    "zip": "wxt zip",
    "build:e2e": "wxt build --mode e2e",
    "dev": "wxt",
    "typecheck": "wxt prepare && tsc -p .",
    "e2e": "wxt build --mode e2e && playwright test",
    "store-assets": "wxt build --mode e2e && playwright test -c playwright.store.config.ts"
  },
  "dependencies": {
    "@harkback/core": "workspace:*",
    "@harkback/spec": "workspace:*",
    "@mozilla/readability": "^0.6.0",
    "@tesseract.js-data/eng": "1.0.0",
    "pdfjs-dist": "^6.3.289",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "wxt": "0.21.4"
  }
}
